    "not_found": {
      "code": "not_found",
      "message": "Entity not found",
      "description": "Requested entity or resource doesn't exist"
    },
    "unauthorized": {
      "code": "unauthorized",
      "message": "Unauthorized",
      "description": "Authentication required or insufficient permissions"
    }
  }
