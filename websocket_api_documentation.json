            "context": {
              "id": "context123",
              "user_id": "user123"
            }
          }
        ]
      }
    },
    {
      "command": "subscribe_entities",
      "description": "Subscribe to entity state changes (gets initial states + real-time updates)",
      "required": true,
      "request": {
        "id": 2,
        "type": "subscribe_entities"
      },
      "optional_params": [
        {
          "name": "entity_ids",
          "type": "array",
          "example": ["climate.yh_thermostat", "switch.mock_switch"],
          "description": "Subscribe to specific entities only"
        },
        {
          "name": "include",
          "type": "array",
          "example": ["climate.*"],
          "description": "Include filter pattern"
        },
        {
          "name": "exclude",
          "type": "array",
          "example": ["sensor.*"],
          "description": "Exclude filter pattern"
        }
      ],
      "response": {
        "id": 2,
        "type": "result",
        "success": true,
        "result": null
      }
    },
    {
      "command": "call_service",
      "description": "Call a Home Assistant service (control devices)",
      "required": true,
      "request": {
        "id": 3,
        "type": "call_service",
        "domain": "climate",
        "service": "set_temperature",
        "service_data": {
          "temperature": 25
        },
        "target": {
          "entity_id": "climate.yh_thermostat"
        }
      },
      "response": {
        "id": 3,
        "type": "result",
        "success": true,
        "result": {
          "context": {
