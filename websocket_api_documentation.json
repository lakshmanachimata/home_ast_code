  "usage_examples": {
    "complete_session": {
      "description": "Complete WebSocket session to get all entities and control thermostat",
      "steps": [
        {
          "step": 1,
          "action": "Connect to WebSocket",
          "code": "const ws = new WebSocket('ws://localhost:8123/api/websocket');"
        },
        {
          "step": 2,
          "action": "Authenticate",
          "request": {
            "type": "auth",
            "access_token": "YOUR_LONG_LIVED_ACCESS_TOKEN"
          },
          "response": {
            "type": "auth_ok"
          }
        },
        {
          "step": 3,
          "action": "Get all entity states",
          "request": {
            "id": 1,
            "type": "get_states"
          }
        },
        {
          "step": 4,
          "action": "Control thermostat",
          "request": {
            "id": 2,
            "type": "call_service",
            "domain": "climate",
            "service": "set_temperature",
            "service_data": {
              "temperature": 25
            },
            "target": {
              "entity_id": "climate.yh_thermostat"
            }
          }
        },
        {
          "step": 5,
          "action": "Subscribe to real-time updates",
          "request": {
            "id": 3,
            "type": "subscribe_entities"
          }
        }
      ]
    }
  },
