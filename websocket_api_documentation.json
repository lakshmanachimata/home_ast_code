{
  "title": "Home Assistant WebSocket API Documentation",
  "description": "Complete documentation for WebSocket API commands with request/response payloads",
  "version": "1.0.0",
  "commands": [
    {
      "command": "auth",
      "description": "Authenticate with the WebSocket API",
      "required": true,
      "request": {
        "id": 0,
        "type": "auth",
        "access_token": "YOUR_LONG_LIVED_ACCESS_TOKEN"
      },
      "response_success": {
        "type": "auth_ok",
        "ha_version": "2024.10.0"
      },
      "response_error": {
        "type": "auth_invalid",
        "message": "Invalid access token"
      }
    },
    {
      "command": "get_states",
      "description": "Get current state of all entities",
      "required": true,
      "request": {
        "id": 1,
        "type": "get_states"
      },
      "response": {
        "id": 1,
        "type": "result",
        "success": true,
        "result": [
          {
            "entity_id": "climate.yh_thermostat",
            "state": "idle",
            "attributes": {
              "current_temperature": 28,
              "temperature": 23,
              "hvac_modes": ["heat", "cool", "off"],
              "friendly_name": "YH Thermostat"
            },
            "last_changed": "2024-01-01T12:00:00.000Z",
